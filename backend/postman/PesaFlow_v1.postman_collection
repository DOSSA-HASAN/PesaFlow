                  "var qrBase64 = jsonData.data.QRCode;",
                  "",
                  "var template = `",
                  "  <html>",
                  "    <body style=\"display:flex; flex-direction:column; align-items:center; font-family:sans-serif; padding:20px;\">",
                  "      <h2>Generated QR Code</h2>",
                  "      <img src=\"data:image/png;base64,${qrBase64}\" style=\"width:300px; height:300px; border:1px solid #ccc; padding:10px;\" />",
                  "      <p style=\"margin-top:10px; color:#555;\">{{message}}</p>",
                  "    </body>",
                  "  </html>",
                  "`;",
                  "",
                  "pm.visualizer.set(template, {",
                  "  message: jsonData.message",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
